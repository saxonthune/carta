    {
      "id": "cmd.attach",
      "kind": "carta.command",
      "props": {
        "name": "attach",
        "summary": "Copy a non-md file into a host doc's bundle, sharing the host's NN prefix",
        "cli": "carta attach <host> <source> [--rename SLUG] [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.copy",
      "kind": "carta.command",
      "props": {
        "name": "copy",
        "summary": "Copy an external file into the workspace at a numbered position",
        "cli": "carta copy <source> <destination> [--order N] [--rename SLUG] [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.create",
      "kind": "carta.command",
      "props": {
        "name": "create",
        "summary": "Create a new numbered .md file with draft frontmatter",
        "cli": "carta create <destination> <slug> [--order N] [--title TEXT] [--summary TEXT] [--tags CSV] [--deps CSV] [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.delete",
      "kind": "carta.command",
      "props": {
        "name": "delete",
        "summary": "Delete entries, gap-close siblings, rewrite refs, report orphans",
        "cli": "carta delete <target> [<target> ...] [--dry-run] [--output-mapping]"
      },
      "tags": []
    },
    {
      "id": "cmd.flatten",
      "kind": "carta.command",
      "props": {
        "name": "flatten",
        "summary": "Hoist a directory's children into the parent, renumber, rewrite refs",
        "cli": "carta flatten <target> [--keep-index] [--force] [--at N] [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.move",
      "kind": "carta.command",
      "props": {
        "name": "move",
        "summary": "Move or reorder a file/directory, renumbering siblings and rewriting refs",
        "cli": "carta move <source> <destination> [--order N] [--mkdir] [--rename SLUG] [--no-regen] [--no-gap-close] [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.punch",
      "kind": "carta.command",
      "props": {
        "name": "punch",
        "summary": "Expand a leaf NN-slug.md into a directory NN-slug/00-index.md",
        "cli": "carta punch <target> [--as-child] [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.regenerate",
      "kind": "carta.command",
      "props": {
        "name": "regenerate",
        "summary": "Rebuild MANIFEST.md from frontmatter across all workspace docs",
        "cli": "carta regenerate [--dry-run]"
      },
      "tags": []
    },
    {
      "id": "cmd.rename",
      "kind": "carta.command",
      "props": {
        "name": "rename",
        "summary": "Change the slug of an entry and its bundle without changing NN or refs",
        "cli": "carta rename <target> <new-slug> [--no-regen]"
      },
      "tags": []
    },
    {
      "id": "cmd.rewrite",
      "kind": "carta.command",
      "props": {
        "name": "rewrite",
        "summary": "Apply explicit old=new doc-ref rewrites across the workspace",
        "cli": "carta rewrite <old>=<new> [<old>=<new> ...] [--dry-run]"
      },
      "tags": []
    }
